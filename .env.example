# MediKiosk+ Environment Variables
# Copy this file to .env and fill in your values.

# ──────────────────────────────────────────────
# GEMINI_API_KEY (Optional)
# Get a free key at: https://aistudio.google.com/app/apikey
# If left blank, the app uses a built-in deterministic fallback engine.
GEMINI_API_KEY=""

# ──────────────────────────────────────────────
# APP_URL
# The base URL where this app is hosted.
APP_URL="http://localhost:3000"

# ──────────────────────────────────────────────
# MySQL Workbench Database Configuration
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="your_mysql_password"
DB_NAME="medikiosk"

# ──────────────────────────────────────────────
# Twilio WhatsApp & SMS Credentials (Optional / Placeholder)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ──────────────────────────────────────────────
# ABDM Sandbox Credentials (Placeholders for later activation)
ABDM_CLIENT_ID=""
ABDM_CLIENT_SECRET=""
ABDM_FACILITY_ID=""
ABDM_SANDBOX_BASE_URL="https://dev.abdm.gov.in"
