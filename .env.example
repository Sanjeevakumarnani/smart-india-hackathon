# MediKiosk+ Environment Variables
# Copy this file to .env and fill in your values.

# ──────────────────────────────────────────────
# SARVAM AI (Primary — Speech, Translation, Chat)
# Get a key at: https://dashboard.sarvam.ai
# Primary provider for STT (Saaras v4), TTS (Bulbul v3), Translation (Mayura),
# Language Identification, and Chat Completion (Sarvam-105B).
# Falls back to Groq if SARVAM_API_KEY is unset.
SARVAM_API_KEY=""

# ──────────────────────────────────────────────
# GROQ AI (Fallback — Text, Vision, Chat)
# Get a free key at: https://console.groq.com/keys
# Used as fallback when Sarvam is unavailable. Also handles vision/OCR tasks.
# The Groq API key is server-only and is never exposed to the React frontend.
GROQ_API_KEY=""
GROQ_DEFAULT_MODEL="qwen/qwen3.8-27b"
GROQ_FAST_MODEL="openai/gpt-oss-20b"
GROQ_REASONING_MODEL="openai/gpt-oss-120b"
GROQ_VISION_MODEL="qwen/qwen3.8-27b"
GROQ_SPEECH_MODEL="whisper-large-v3-turbo"

# ──────────────────────────────────────────────
# APP_URL
# The base URL where this app is hosted.
APP_URL="http://localhost:3000"

# ──────────────────────────────────────────────
# Local demo identity mode
# Synthetic Telangana fixtures are used only when MySQL/ABDM are unavailable.
# These are STRICT gates: demo OTP is only issued when DEMO_MODE="true".
# The OTP is printed to the server console only when DEMO_LOG_OTP="true" too.
DEMO_MODE="true"
DEMO_LOG_OTP="true"
# When "true", unknown demo identities may be registered via the OTP flow.
# When "false" (default), unknown identities are blocked at the identity step.
DEMO_ALLOW_REGISTRATION="false"

# ──────────────────────────────────────────────
# MySQL Workbench Database Configuration
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="your_mysql_password"
DB_NAME="medikiosk"

# ──────────────────────────────────────────────
# Twilio WhatsApp & SMS Credentials (Optional / Placeholder)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ──────────────────────────────────────────────
# ABDM Sandbox Credentials (Placeholders for later activation)
ABDM_CLIENT_ID=""
ABDM_CLIENT_SECRET=""
ABDM_FACILITY_ID=""
ABDM_SANDBOX_BASE_URL="https://dev.abdm.gov.in"
