# Base URL of the MediKiosk+ backend (Express API).
# The frontend is deployed separately (Vercel) from the backend (Render),
# so every API call goes to this absolute origin.
#
# For local development the backend runs on http://localhost:3000 — this is
# already the default in src/config/api.ts, so you only need this variable on
# deployed environments. Copy this file to `.env.local` when overriding.
VITE_API_URL=http://localhost:3000