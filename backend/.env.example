# ─────────────────────────────────────────────────────────────────────────────
# MediKiosk+ Backend Environment Variables
# Copy this file to `.env` in the backend/ folder and fill in your values.
# On Render, set the same keys as Environment Variables in the dashboard —
# never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
# Port the Express API listens on. Render injects `PORT` automatically.
PORT="3000"
# Set to "production" on Render (Render sets this for you).
NODE_ENV="development"
# Comma-separated list of allowed frontend origins (CORS). Include localhost
# for local development and your Vercel domain for production.
# Example: https://medikiosk.vercel.app,http://localhost:5173
FRONTEND_URL="http://localhost:5173"
# Session/token signing secret. MUST be set to a long random value in
# production or the server refuses to boot (hard fail).
JWT_SECRET="replace-with-a-long-random-secret"
# Base URL of the deployed frontend (used for outbound links/referrals only).
APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# MySQL Database
# ─────────────────────────────────────────────────────────────
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="your_mysql_password"
DB_NAME="medikiosk"
# Managed cloud providers (Aiven, PlanetScale, DigitalOcean, …) require TLS.
# Set DB_SSL="true" to enable; optionally pin the CA bundle with DB_SSL_CA and
# relax validation (only if the provider requires it) with DB_SSL_REJECT_UNAUTHORIZED="false".
DB_SSL="false"
DB_SSL_CA=""
DB_SSL_REJECT_UNAUTHORIZED="true"
# The server keeps an in-memory fallback datastore so a transient database
# outage never crashes the kiosk. Data written during fallback is not persisted.

# ─────────────────────────────────────────────────────────────
# SARVAM AI (Primary — Speech, Translation, Chat)
# Key at: https://dashboard.sarvam.ai
SARVAM_API_KEY=""

# ─────────────────────────────────────────────────────────────
# GROQ AI (Fallback — Text, Vision, Chat; server-only, never exposed to the
# React frontend). Free key at: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_DEFAULT_MODEL="qwen/qwen3.8-27b"
GROQ_FAST_MODEL="openai/gpt-oss-20b"
GROQ_REASONING_MODEL="openai/gpt-oss-120b"
GROQ_VISION_MODEL="qwen/qwen3.8-27b"
GROQ_SPEECH_MODEL="whisper-large-v3-turbo"

# ─────────────────────────────────────────────────────────────
# ABDM (Ayushman Bharat Digital Mission) Gateway
# Use the sandbox at https://dev.abdm.gov.in — leave blank during local dev;
# the API degrades gracefully and demo identity mode engages automatically when
# ABDM is unconfigured.
ABDM_BASE_URL=""
ABDM_CLIENT_ID=""
ABDM_CLIENT_SECRET=""
ABDM_FACILITY_ID=""
# Tuning (optional, defaults shown):
ABDM_TIMEOUT_MS="12000"
ABDM_TOKEN_REFRESH_SKEW_MS="60000"
ABDM_MAX_RETRIES="2"
ABDM_CERT_CACHE_TTL_MS="3600000"

# ─────────────────────────────────────────────────────────────
# Bhashini (Government of India ASR — fallback speech recognition)
# Credentials from: https://bhashini.gov.in
BHASHINI_API_KEY=""
BHASHINI_USER_ID=""

# ─────────────────────────────────────────────────────────────
# Twilio WhatsApp & SMS (optional)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ─────────────────────────────────────────────────────────────
# Demo-mode controls (documented controls)
# Note: the current codebase derives demo behaviour from whether ABDM is
# configured (see backend/src/services/patientVerificationWorkflow.ts), not
# from these flags — they are kept here as reserved/explicit switches.
DEMO_MODE="false"
DEMO_LOG_OTP="false"
DEMO_ALLOW_REGISTRATION="false"